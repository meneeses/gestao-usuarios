{
  "info": {
    "_postman_id": "926a3f4c-d1f0-42ad-b401-sentinela2026",
    "name": "Sentinela — Gestão Segura de Usuários",
    "description": "Coleção acadêmica da API REST. Execute Login como administrador antes do CRUD; o token e o ID criado são salvos automaticamente como variáveis da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "usuarioId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Infraestrutura",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/health" },
          "response": []
        },
        {
          "name": "Contrato OpenAPI",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/openapi.json" },
          "response": []
        }
      ]
    },
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login como administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login realizado', () => pm.response.to.have.status(200));",
                  "const resposta = pm.response.json();",
                  "pm.collectionVariables.set('token', resposta.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sistema.com\",\n  \"senha\": \"Admin@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Usuário da sessão",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/auth/me"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Usuários — administrador",
      "item": [
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/usuarios"
          },
          "response": []
        },
        {
          "name": "Criar usuário",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Usuário criado', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('usuarioId', pm.response.json().usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuária Postman\",\n  \"email\": \"postman@sistema.com\",\n  \"senha\": \"Postman@123\",\n  \"perfil\": \"cliente\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios"
          },
          "response": []
        },
        {
          "name": "Consultar usuário criado",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          },
          "response": []
        },
        {
          "name": "Atualizar usuário criado",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuária Postman Atualizada\",\n  \"email\": \"postman@sistema.com\",\n  \"perfil\": \"operador\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          },
          "response": []
        },
        {
          "name": "Excluir usuário criado",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Evidência de RBAC",
      "item": [
        {
          "name": "Login como operador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login realizado', () => pm.response.to.have.status(200));",
                  "const resposta = pm.response.json();",
                  "pm.collectionVariables.set('token', resposta.token);",
                  "pm.collectionVariables.set('usuarioId', resposta.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operador@sistema.com\",\n  \"senha\": \"Operador@123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "response": []
        },
        {
          "name": "Bloquear elevação de operador (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Elevação bloqueada', () => pm.response.to.have.status(403));"]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Operador de Demonstração\",\n  \"email\": \"operador@sistema.com\",\n  \"perfil\": \"administrador\"\n}"
            },
            "url": "{{baseUrl}}/api/usuarios/{{usuarioId}}"
          },
          "response": []
        }
      ]
    }
  ]
}
